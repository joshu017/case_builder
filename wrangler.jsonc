{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "case-builder",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-07",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "joshjacobson.net/casebuilder", "zone_name": "joshjacobson.net" },
    { "pattern": "joshjacobson.net/casebuilder/*", "zone_name": "joshjacobson.net" }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "observability": { "enabled": true }
}
